[Unit]
Description=BLACKCHAIN testnet faucet, 127.0.0.1:8080
Documentation=file:///home/hatch/workspace/blackchain/repo/systemd/README.md
After=network.target blackchain-val1.service
Wants=blackchain-val1.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/blackchain/repo/faucet
Environment=HOME=/home/hatch
# Faucet butuh JSON-RPC val1 (127.0.0.1:8655); After= di atas memastikan
# val1 di-start lebih dulu. Jangan start duplikat bila sudah menjawab.
ExecCondition=/bin/bash -c '! curl -sf -m 3 http://127.0.0.1:8080/api/status >/dev/null'
ExecStart=/home/hatch/workspace/blackchain/repo/faucet/start.sh
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/hatch/workspace/blackchain/repo/faucet/faucet.log
StandardError=inherit

[Install]
WantedBy=blackchain.target
